@article{yu2026climbflow,
  abbr     = {arXiv},
  title    = {CLIMB-Flow: Coupled Linear Inverse Posterior Sampling via Multiscale-Based Flow},
  author   = {Yu, Z. and Yuan, R. and Chand, J. R. and Murtaza, S. and Jacob, M.},
  journal  = {arXiv preprint},
  year     = {2026},
  abstract = {CLIMB-Flow is a training-free stochastic solver for linear inverse problems with cascaded pixel-space flow models. It samples an exact stage-wise Bayesian posterior over coupled clean and noise endpoints using split Gibbs-Langevin dynamics with a measurement-aware conjugate-gradient preconditioner, and proceeds coarse-to-fine while keeping the original linear observation model. Experiments cover inpainting, deblurring, 4x super-resolution, and 8x accelerated MRI on ImageNet-256, AFHQ-512, and fastMRI.},
  selected = {true}
}

@inproceedings{yu2024knee,
  abbr       = {SPIE},
  title      = {3D spatial and channel reconstruction for large image patch based segmentation of knee anatomical structures on MRI},
  author     = {Yu, Z. and Zhao, X. and Singh, J. and Wang, J. and Yu, T. and Barot, D. and Pu, J.},
  booktitle  = {Medical Imaging 2024: Image Processing, Proc. SPIE 12926},
  year       = {2024},
  doi        = {10.1117/12.3006799},
  award_name = {Oral},
  award      = {Oral presentation at SPIE Medical Imaging 2024.},
  abstract   = {We introduce a 3D spatial-and-channel reconstruction module that suppresses redundant features in nnU-Net, enabling larger volumetric input patches for segmenting knee anatomical structures on MRI. On 183 radiologist-annotated knee MRI scans covering nine structures, it raises mean Dice from 0.811 to 0.823 at the same patch size with fewer parameters, and reaches 0.825 with larger patches.},
  selected   = {true}
}

