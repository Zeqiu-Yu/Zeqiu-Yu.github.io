@inproceedings{yu2026lhm,
  abbr      = {NeurIPS},
  title     = {Low-Rank Hierarchical Merging for Efficient Long-to-Short Reasoning},
  author    = {Yu, Z. and Zhang, X. and Zhao, W. and Wang, S.},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2026},
  preview   = {lhm.jpg},
  abstract  = {Low-Rank Hierarchical Merging (LHM) is a training-free, plug-and-play framework that combines the reasoning ability of long chain-of-thought models with the concise generation of their base LLMs through layer-adaptive parameter merging. Merging coefficients come from a Layer Second-Order Sensitivity (LSOS) index, built from task-data-free Hessian trace estimates and task-vector norms, together with a dual-constraint coefficient mapping that protects reasoning-critical layers. On the 1.5B Qwen setting, LHM reaches 48.8% average accuracy across six math benchmarks, 3.2 points above ORCA-AIM, while shortening the R1 model's responses by 59.7%; the gains carry over to Llama and Mistral model pairs with no added inference latency.},
  selected  = {true}
}

@inproceedings{yuan2026flowalign,
  abbr       = {NeurIPS},
  title      = {Flow-Guided Target-Space Alignment via Path Consistency},
  author     = {Yuan*, R. and Yu*, Z. and Gao, W. and Chen, W. and Tang, X. and Tang, L.},
  booktitle  = {Advances in Neural Information Processing Systems (NeurIPS)},
  year       = {2026},
  preview    = {flowalign.png},
  annotation = {* Equal contribution},
  abstract   = {FlowAlign is a two-stage framework for fixed-target multimodal alignment. It first learns source-conditioned flow fields from paired source and target representations, then reuses the frozen field as a differentiable path-consistency supervisor for mapping new source samples. We derive endpoint-error bounds that tie mapping accuracy to the consistency loss and the field residual. FlowAlign outperforms baselines such as Seurat v5, GLUE, and GENOT on single-cell multi-omics (PBMC/BMMC) and ranks first on DINOv3-to-SigLIP2 image-text alignment (CUBICC).},
  selected   = {true}
}

